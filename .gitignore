######################################
# Terraform
######################################

# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform lock file (optional: keep if using version locking)
.terraform.lock.hcl

######################################
# Sensitive / Secrets (VERY IMPORTANT)
######################################

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Environment files
.env
.env.*
.venv

# AWS credentials
.aws/
credentials
*.pem
*.key

# SSH keys
id_rsa
id_rsa.pub

# Vault / secret tools
vault.hcl

######################################
# OS / System Files
######################################

.DS_Store
Thumbs.db

######################################
# Logs
######################################

*.log

######################################
# IDE / Editor
######################################

.vscode/
.idea/
*.swp
*.swo

######################################
# Node (if used in pipeline / CDK)
######################################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

######################################
# Python (if used for scripts / lambdas)
######################################

__pycache__/
*.pyc
*.pyo
*.pyd

######################################
# Build / Temp Files
######################################

dist/
build/
tmp/
temp/

######################################
# Docker
######################################

.dockerignore
*.tar

######################################
# Kubernetes
######################################

*.kubeconfig

######################################
# Misc
######################################

*.bak
*.backup
